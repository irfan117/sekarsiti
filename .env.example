# ==============================================================================
# SEKARSITI WED - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Salin file ini menjadi `.env` lalu lengkapi kredensial Anda.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SUPABASE (Database Central Klien, Undangan, Tamu, & RSVP)
# ------------------------------------------------------------------------------
# Dapatkan Project URL & Anon Key di: https://supabase.com/dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
VITE_ENABLE_MOCK_ADMIN=false

# Rate limit for Vercel serverless functions (create an Upstash Redis database)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# For a standalone Express server behind a reverse proxy, set the exact trusted hop count.
# Leave at 0 for direct local access. Example: TRUST_PROXY_HOPS=0
TRUST_PROXY_HOPS=0

# ------------------------------------------------------------------------------
# 2. CLOUDINARY (Media Hosting & Optimasi Gambar WebP/AVIF Otomatis)
# ------------------------------------------------------------------------------
# Buat akun gratis di: https://cloudinary.com/
# Cloud Name dapat dilihat di Cloudinary Dashboard.
# Buat Unsigned Upload Preset di: Settings -> Upload -> Upload presets -> Add Upload Preset -> Signing Mode: "Unsigned"
VITE_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=sekarsiti_unsigned_preset

# ------------------------------------------------------------------------------
# 3. CUSTOM ROOT DOMAIN (Untuk Format Link Undangan Berbasis Subdomain)
# ------------------------------------------------------------------------------
# Contoh: jika diisi `sekarsiti.com`, link undangan menjadi:
# https://kirana-adhitya.sekarsiti.com?to=NamaTamu
# Jika kosong, otomatis menggunakan format default host saat ini.
VITE_ROOT_DOMAIN=ssiti.tech

# ------------------------------------------------------------------------------
# 4. SERVER CONFIGURATION
# ------------------------------------------------------------------------------
PORT=3000
NODE_ENV=development

# ------------------------------------------------------------------------------
# 5. MIDTRANS PAYMENT GATEWAY (Otomatisasi Pembayaran Snap QRIS / Virtual Account)
# ------------------------------------------------------------------------------
# Dapatkan di: https://dashboard.midtrans.com/ -> Settings -> Access Keys
# Masukkan Client Key (dimulai dengan Mid-client- atau SB-Mid-client-)
# Masukkan Server Key (dimulai dengan Mid-server- atau SB-Mid-server-)
VITE_MIDTRANS_CLIENT_KEY=Mid-client-your_production_client_key_here
MIDTRANS_SERVER_KEY=Mid-server-your_production_server_key_here
VITE_MIDTRANS_IS_PRODUCTION=true
VITE_MIDTRANS_MERCHANT_ID=
