# ==============================================================================
# SEKARSITI WED - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Salin file ini menjadi `.env` lalu lengkapi kredensial Supabase & Cloudinary Anda.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. GOOGLE GEMINI AI (Fitur Parser Isian Google Form & Generator Kutipan Puitis)
# ------------------------------------------------------------------------------
# Dapatkan API Key gratis di: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# 2. SUPABASE (Database Central Klien, Undangan, Tamu, & RSVP)
# ------------------------------------------------------------------------------
# Dapatkan Project URL & Anon Key di: https://supabase.com/dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ------------------------------------------------------------------------------
# 3. CLOUDINARY (Media Hosting & Optimasi Gambar WebP/AVIF Otomatis)
# ------------------------------------------------------------------------------
# Buat akun gratis di: https://cloudinary.com/
# Cloud Name dapat dilihat di Cloudinary Dashboard.
# Buat Unsigned Upload Preset di: Settings -> Upload -> Upload presets -> Add Upload Preset -> Signing Mode: "Unsigned"
VITE_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=sekarsiti_unsigned_preset

# ------------------------------------------------------------------------------
# 4. CUSTOM ROOT DOMAIN (Untuk Format Link Undangan Berbasis Subdomain)
# ------------------------------------------------------------------------------
# Contoh: jika diisi `sekarsiti.com`, link undangan menjadi:
# https://kirana-adhitya.sekarsiti.com?to=NamaTamu
# Jika kosong, otomatis menggunakan format default host saat ini.
VITE_ROOT_DOMAIN=sekarsiti.com

# ------------------------------------------------------------------------------
# 5. SERVER CONFIGURATION (Opsional)
# ------------------------------------------------------------------------------
PORT=3000
NODE_ENV=development
